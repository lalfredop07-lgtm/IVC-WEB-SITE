# Variables de entorno de la web de IVC. Copiar a .env.local (desarrollo) o definirlas
# en el panel de Vercel (producción). Todas son SOLO de servidor: no usar el prefijo
# NEXT_PUBLIC_ ni exponerlas al navegador. Nunca subir valores reales al repositorio.
# Ver docs/DESPLIEGUE-VERCEL.md

# ── Publicación ─────────────────────────────────────────────────────────────
# Dominio público definitivo (URLs canónicas, sitemap y Open Graph).
SITE_URL=https://www.ivccontratistas.pe
# Indexación en buscadores. Dejar vacío o "false" hasta el lanzamiento aprobado por IVC.
# Aunque valga "true", en Vercel solo se aplica al entorno de producción (nunca a previews).
SITE_INDEXABLE=

# ── Formulario de contacto (/api/contacto) ── ver docs/INTEGRACION-CONTACTO.md
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# ── Postulaciones (/api/postulacion) ── buzón de selección autorizado por IVC.
# Ver docs/INTEGRACION-POSTULACIONES.md
CAREERS_TO_EMAIL=
CAREERS_FROM_EMAIL=
